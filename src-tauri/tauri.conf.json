{
  "productName": "SonicLedger",
  "version": "0.1.1",
  "identifier": "com.sonicledger.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SonicLedger / 音樂隨身聽",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
        "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;",
        "capabilities": ["default"]
    }
  },
  "plugins": {
    "dialog": {},
    "fs": {
      "scope": ["$APP/*"]
    },
    "shell": {
      "open": true
    },
    "notification": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
